<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 复用母仓 ypbin-starter 的依赖管理、插件配置与发布 profile；
         parent 版本显式锁定，不自动跟随（AGENTS 5.3） -->
    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-starter-dependencies</artifactId>
        <!-- 与母仓保持同一基线。钉**已发布正式版** 3.1.0（Central 可解析）：
             ① 干净环境（CI/新机器）可直接构建，无需先装母仓；
             ② 可复现 —— 快照父 pom 会让「本地能构建、CI 不能」。
             NullAway / dependencyConvergence 等门禁 profile 定义在该父 pom 里
             （更早的 2.2.3 没有它们）。 -->
        <version>3.1.0</version>
        <relativePath/>
    </parent>

    <groupId>cn.ypbin</groupId>
    <artifactId>ypbin-iot-starter</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>${project.artifactId}</name>
    <description>ypbin-iot-starter —— 多协议物联网接入框架，只做协议对接</description>
    <url>https://github.com/wenbin-wb/ypbin-iot-starter</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>wenbin</id>
            <name>wenbin</name>
            <roles>
                <role>author</role>
            </roles>
        </developer>
    </developers>

    <modules>
        <module>ypbin-iot-dependencies</module>
        <module>ypbin-iot-bom</module>
        <module>ypbin-iot-core</module>
        <module>ypbin-iot-runtime</module>
        <module>ypbin-iot-transport</module>
        <module>ypbin-iot-spring-boot-starter</module>
        <module>ypbin-iot-protocol-tcp</module>
        <module>ypbin-iot-protocol-modbus</module>
        <module>ypbin-iot-protocol-mqtt</module>
        <module>ypbin-iot-protocol-opcua</module>
        <module>ypbin-iot-test</module>
        <!-- 非发布模块（architecture-tests）不在此处：见 dev-only profile -->
    </modules>

    <properties>
        <revision>0.1.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 网络底座：锁定 4.1 线最新补丁版（PROTOCOLS §4.1） -->
        <netty.version>4.1.138.Final</netty.version>

        <!-- 协议库：Modbus（EPL-2.0） -->
        <modbus.version>2.1.6</modbus.version>

        <!-- 协议库：MQTT -->
        <hivemq.mqtt.version>1.4.0</hivemq.mqtt.version>
        <moquette.version>0.17</moquette.version>

        <!-- 协议库：OPC UA（MPL-2.0 / EPL-2.0 双许可） -->
        <milo.version>1.1.7</milo.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- 覆盖母仓 parent 内联的 license header 署名，
                     否则本仓所有文件会被强制署上 ypbin-starter authors（DESIGN §2.1） -->
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <configuration>
                        <java>
                            <licenseHeader>
                                <content><![CDATA[/*
 * Copyright (c) 2024-present ypbin-iot-starter authors.
 *
 * Licensed under the Apache License, Version 2.0 (the "License");
 * you may not use this file except in compliance with the License.
 * You may obtain a copy of the License at
 *
 *     https://www.apache.org/licenses/LICENSE-2.0
 *
 * Unless required by applicable law or agreed to in writing, software
 * distributed under the License is distributed on an "AS IS" BASIS,
 * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
 * See the License for the specific language governing permissions and
 * limitations under the License.
 */
]]></content>
                            </licenseHeader>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                            <importOrder/>
                            <removeUnusedImports/>
                        </java>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    <profiles>
        <!--
          非发布模块隔离 profile（activeByDefault）。

          为什么必须这样做：`maven.deploy.skip=true` 对 central-publishing-maven-plugin
          （extensions=true 接管 deploy 生命周期）**无效**，未签名的架构测试产物会混进
          Central 上传包并导致整个 deployment 校验失败（母仓 3.0.0 首发即如此）。
          把它放进 activeByDefault profile，`-Prelease` 会自动排除。

          ⚠️ 副作用（与母仓一致）：只要显式激活任一 profile（如 `-Psbom`），本 profile 即失效，
          架构门禁就不会跑。故 `sbom` profile 里补一份带回它；发布前的完整门禁由
          CI 常规 job（`mvn clean test`，无 `-P`）保证。
          新增不发布模块时必须同时加进本 profile 与 sbom profile，
          由 ModulePublishingTest 强制校验。
        -->
        <profile>
            <id>dev-only</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>ypbin-iot-architecture-tests</module>
                <module>ypbin-iot-integration-tests</module>
            </modules>
        </profile>

        <!--
          发布 profile（与母仓同一套做法）。

          为什么根 pom 要独立声明发布插件：根聚合 pom 的 parent 是
          ypbin-starter-dependencies，而 central-publishing 配置在母仓的**根 pom** 里，
          不在已发布的父 pom 中 —— 因此这里必须自己声明一份。

          子模块由 dev-only（activeByDefault）承载；-Prelease 会让它失效，
          架构测试模块自动离开发布反应堆（这正是我们要的）。
          excludeArtifacts 仍显式排除它：该插件 extensions=true 接管 deploy 生命周期，
          **不读取 maven.deploy.skip**，只按 artifactId 比对（写 groupId:artifactId 不匹配）。
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <excludeArtifacts>
                                <artifact>ypbin-iot-architecture-tests</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          集成测试 profile（复用父 pom 的 it profile 定义：它只加了 failsafe）。

          必须在这里补 <modules>：显式激活任一 profile 都会让 activeByDefault 的
          dev-only 失效，不补的话 `-Pit verify` 的反应堆里**没有集成测试模块** ——
          命令会"成功"但一个 IT 都没跑（这正是「门禁空转」的经典形态）。

          在这里**显式跳过 surefire**：`-Pit` 的语义就是「只跑集成测试」。
          为什么不用命令行开关 `-Dsurefire.skip=true`：**它在本项目不生效**
          （实测：CI 的 IT 作业日志里 11 个模块的 surefire 全部执行、没有任何
          "Tests are skipped" 记录，等于把全量单测重复跑了一遍）。
          放在 profile 配置里是声明式的，而且可以被 CI 的断言真正验证。
        -->
        <profile>
            <id>it</id>
            <modules>
                <module>ypbin-iot-architecture-tests</module>
                <module>ypbin-iot-integration-tests</module>
            </modules>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 供应链合规：生成 CycloneDX SBOM。显式带回架构测试模块，保证 SBOM 覆盖完整。 -->
        <profile>
            <id>sbom</id>
            <modules>
                <module>ypbin-iot-architecture-tests</module>
                <module>ypbin-iot-integration-tests</module>
            </modules>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <version>2.9.3</version>
                        <executions>
                            <execution>
                                <id>make-bom</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <projectType>library</projectType>
                            <outputFormat>json</outputFormat>
                            <outputName>bom</outputName>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
