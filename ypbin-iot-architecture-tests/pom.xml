<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-iot-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ypbin-iot-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-iot-architecture-tests</artifactId>

    <properties>
        <!-- 架构约束测试不发布：它只在构建期做门禁，没有任何运行期价值。
             与根 pom 的 dev-only profile 配合，避免未签名产物混进上传包
             （母仓 3.0.0 首次发布就因这个栽过：maven.deploy.skip 对
             central-publishing-maven-plugin 无效，必须先离开发布反应堆）。 -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <name>${project.artifactId}</name>
    <description>架构约束测试（不发布）：分层、零 Spring、装配规则与规则有效性自检</description>

    <dependencies>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-transport</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-spring-boot-starter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-protocol-tcp</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 必须把**全部**协议模块放进 classpath：ArchUnit 规则用 importPackages("cn.ypbin.iot")，
             不在 classpath 上的模块会被**静默跳过**——「协议实现包不得使用 Spring 类型」
             这类规则会看起来通过、实则从未检查过它们。 -->
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-protocol-modbus</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-protocol-mqtt</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-protocol-opcua</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
