<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-iot-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ypbin-iot-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-iot-protocol-tcp</artifactId>

    <name>${project.artifactId}</name>
    <description>通用 TCP 透传协议适配器（M0 验收载体）</description>

    <dependencies>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ypbin</groupId>
            <artifactId>ypbin-iot-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <!-- 配置元数据处理器：没有它，宿主 IDE 对 ypbin.iot.protocol.* 的配置项
             不会有任何补全与说明（不会报错，只是静默失去提示）。
             由 tools/export-config-metadata.mjs 的 check 模式在 CI 守住。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <properties>
        <!-- 参与 NullAway 空值语义检查（父 pom 的 nullaway profile 据此限定检查范围） -->
        <nullaway.packages>cn.ypbin.iot.protocol.tcp</nullaway.packages>
    </properties>
</project>
