<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.ypbin</groupId>
        <artifactId>ypbin-iot-starter</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ypbin-iot-dependencies</artifactId>
    <packaging>pom</packaging>

    <name>${project.artifactId}</name>
    <description>IoT 模块统一版本管理，同时作为全部 IoT 子模块的 parent</description>

    <dependencyManagement>
        <dependencies>
            <!-- Netty BOM：协议模块只引 BOM，不写 artifact 版本（PROTOCOLS §4.7） -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 本仓模块 -->
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-runtime</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-transport</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-spring-boot-starter</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-protocol-tcp</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>cn.ypbin</groupId>
                <artifactId>ypbin-iot-test</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 测试基座：全部模块统一 JUnit 5 + AssertJ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
